script 16 mmz4 {
	mugshotShow
		mugshot = 25
	"""
	¡Kyajajaja!
	"""
	msgClear
	"""
	¡Debes estar que
	ardes para llegar
	hasta aquí!
	"""
	msgClear
	"""
	Ah, pero no
	estás ardiendo lo
	suficiente para mí.
	"""
	msgClear
	"""
	¡Quiero verte sudar!
	¡Quiero ver lágrimas!
	"""
	msgClear
	"""
	¡Muéstrame todo
	lo que tienes!
	"""
	msgClear
	"""
	¡Me encanta convertir
	a tipos como tú
	en carbón!
	"""
	msgClear
	"""
	¡Ahora es hora de
	que te quemes!
	"""
	end
}

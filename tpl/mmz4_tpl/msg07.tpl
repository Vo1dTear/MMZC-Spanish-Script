script 0 mmz4 {
	mugshotShow
		mugshot = 36
	"""
	Operadora:
	"¡Hay generadores
	 de lluvia ácida!"
	"""
	msgClear
	"""
	"¡Destrúyelos y
	 salva el terreno
	 de abajo!"
	"""
	end
}
script 16 mmz4 {
	mugshotShow
		mugshot = 21
	"""
	Arrasaré con las
	inmundas alimañas
	de abajo...
	"""
	msgClear
	"""
	Lord Weil ideó un
	plan tan hermoso
	como yo.
	"""
	msgClear
	"""
	Todas las cosas
	feas deben
	inclinarse ante mí.
	"""
	msgClear
	"""
	¡Pegasolta Eclair
	te enviará a las
	profundidades!
	"""
	end
}
script 17 mmz4 {
	mugshotShow
		mugshot = 21
	"""
	¡Jajaja!
	¡Sufre tu gran y
	espantoso destino!
	"""
	msgClear
	"""
	¡Mi belleza es un
	regalo para los ojos
	de alguien tan feo!
	"""
	end
}
script 18 mmz4 {
	mugshotShow
		mugshot = 21
	"""
	¡Wah!
	¿¡Cómo pudo
	pasarme esto!?
	"""
	msgClear
	"""
	¿Tú...
	vencerme?
	"""
	msgClear
	"""
	Eso es imposible...
	"""
	msgClear
	"""
	Pero... mi muerte,
	¡es tan hermosa!
	"""
	end
}

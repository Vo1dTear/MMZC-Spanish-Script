@archive msg0C
@size 19

script 0 mmz4 {
	mugshotShow
		mugshot = 36
	"""
	Operadora:
	"Zero..."
	"""
	msgClear
	"""
	"Esta área está
	 controlada desde
	 dos ubicaciones."
	"""
	msgClear
	"""
	"Una es la torre de
	 control y la otra
	"""
	msgClear
	"""
	 es la sala de
	 computadoras
	 más allá de ella."
	"""
	msgClear
	"""
	"Sigue adelante y
	 detén esa torre
	 de control."
	"""
	end
}
script 1 mmz4 {
	mugshotShow
		mugshot = 36
	"""
	Operadora:
	"¡Zero, ahí está la
	 torre de control!"
	"""
	msgClear
	"""
	"No puedes
	 destruirla
	 directamente,
	"""
	msgClear
	"""
	 pero puedes sacar
	 el disco clave y
	 desactivarla."
	"""
	end
}
script 16 mmz4 {
	mugshotShow
		mugshot = 31
	"""
	¡Kyakya!
	¡Te he estado
	esperando, Zero!
	"""
	msgClear
	"""
	¡Me dejaste en
	ridículo la última
	vez que nos vimos!
	"""
	msgClear
	"""
	¡Pero te aseguro
	que no pasará
	de nuevo!
	"""
	msgClear
	"""
	¡Soy Cocapetri, de
	los ocho guerreros
	Einherjar!
	"""
	msgClear
	"""
	¡Veremos Ragnarok
	hasta el final!
	¡Kyakya!
	"""
	msgClear
	mugshotShow
		mugshot = 4
	"""
	¿Así que tú eres
	el que controla
	la seguridad aquí?
	"""
	msgClear
	mugshotShow
		mugshot = 31
	"""
	¡Kyakya!
	¿Sorprendido?
	"""
	msgClear
	"""
	¡Es todo gracias
	al programa virus
	de Lord Weil!
	"""
	msgClear
	"""
	¡Se encarga de los
	intrusos sin que yo
	mueva un dedo!
	"""
	msgClear
	mugshotShow
		mugshot = 4
	"""
	Así que eres del tipo
	que no puede hacer
	nada por sí mismo...
	"""
	msgClear
	mugshotShow
		mugshot = 31
	"""
	¡Kya! ¡Primero
	"esbirro", y
	ahora esto!
	"""
	msgClear
	"""
	¡Imperdonable!
	"""
	msgClear
	"""
	¡Te convertiré
	en un adorno de
	jardín!
	"""
	end
}
script 17 mmz4 {
	mugshotShow
		mugshot = 31
	"""
	¡Kyakya!
	"""
	msgClear
	"""
	¿Tienes problemas
	para moverte ahí,
	tipo duro?
	"""
	msgClear
	"""
	Oh, lo siento.
	¡Fue mi culpa!
	"""
	msgClear
	"""
	¿Y ahora quién no
	puede hacer nada por
	sí mismo? ¡Kyakya!
	"""
	end
}
script 18 mmz4 {
	mugshotShow
		mugshot = 31
	"""
	Kya...kya...
	¿Por qué no puedo
	moverme?
	"""
	msgClear
	"""
	No me habré
	convertido en
	piedra, ¿verdad?
	"""
	msgClear
	"""
	No...es...
	el miedo lo que
	me paraliza...
	"""
	msgClear
	"""
	Kuh...
	¡Kyakyaaa!
	"""
	end
}

script 13 mmz4 {
	mugshotShow
		mugshot = 4
	"""
	Solo somos
	Reploides diseñados
	para la guerra.
	"""
	msgClear
	"""
	No nos corresponde
	cambiar el mundo.
	"""
	msgClear
	"""
	Eso depende de
	humanos como Ciel
	y Neige.
	"""
	msgClear
	"""
	Como Reploides,
	solo podemos
	prestar nuestra
	"""
	msgClear
	"""
	fuerza a quienes
	confiamos.
	"""
	msgClear
	mugshotShow
		mugshot = 33
	"""
	¿Confiar? ¿Y en
	quién debería
	confiar?
	"""
	msgClear
	"""
	¿En los humanos que
	no hacen nada
	mientras su mundo
	"""
	msgClear
	"""
	se desmorona?
	"""
	msgClear
	"""
	¿En los humanos que
	nos temen, a sus
	propias creaciones?
	"""
	msgClear
	"""
	¿O en los humanos
	que intentan
	conquistar el mundo?
	"""
	msgClear
	"""
	¿¡Peleamos entre
	nosotros por ellos!?
	"""
	msgClear
	"""
	Este mundo grita de
	dolor bajo ellos...
	"""
	msgClear
	"""
	¿Por qué debería
	confiar en alguien?
	"""
	msgClear
	"""
	¿Cómo puedes confiar
	en ellos? ¿Cómo
	puedes luchar?
	"""
	end
}

	"""
	end
}
script 18 mmz4 {
	mugshotShow
		mugshot = 61
	"""
	El malvado Dr. Weil,
	quien fue expulsado
	de Neo Arcadia...
	"""
	msgClear
	"""
	Ahora controla toda
	la energía y la
	producción allí
	"""
	msgClear
	"""
	y en todas partes,
	porque cierto
	"héroe" derrotó
	"""
	msgClear
	"""
	al líder de
	Neo Arcadia.
	"""
	msgClear
	"""
	El gran santuario
	para nosotros,
	los humanos...
	"""
	msgClear
	"""
	Ya no existe...
	"""
	msgClear
	mugshotShow
		mugshot = 58
	"""
	Pero entonces eso
	significa que lo
	que hicimos fue...
	"""
	msgClear
	mugshotShow
		mugshot = 9
	"""
	Los humanos temen
	ser "eliminados"
	si se oponen a Weil,
	"""
	msgClear
	"""
	así que gobierna
	sin oposición.
	"""
	msgClear
	"""
	Mientras guarden
	silencio, estarán
	a salvo...
	"""
	msgClear
	mugshotShow
		mugshot = 61
	"""
	Pero quién sabe
	cuánto tardará Weil
	en decidir deshacerse
	"""
	msgClear
	"""
	de ellos también.
	"""
	msgClear
	"""
	Por eso hemos huido
	de ese lugar.
	"""
	msgClear
	mugshotShow
		mugshot = 9
	"""
	Vamos hacia el
	asentamiento en
	Área Zero.
	"""
	end
}

script 14 mmz4 {
	msgBottom
	mugshotShow
		mugshot = 9
	"""
	Me llamo Neige,
	soy humana igual
	que tú.
	"""
	msgClear
	"""
	Antes era
	periodista y
	recorría el mundo.
	"""
	msgClear
	"""
	Por eso oí rumores
	sobre ti y la
	Resistencia.
	"""
	msgClear
	"""
	Que lideraste a los
	Reploides contra
	Neo Arcadia...
	"""
	msgClear
	"""
	Y que se supone
	eres muy peligrosa.
	"""
	msgClear
	mugshotShow
		mugshot = 58
	"""
	¿Peligrosa?
	Nosotros no...
	"""
	msgClear
	mugshotShow
		mugshot = 4
	"""
	...
	"""
	msgClear
	mugshotShow
		mugshot = 9
	"""
	También he oído
	mucho sobre ti.
	"""
	msgClear
	"""
	Sabía que estabas
	en la Resistencia
	cuando oí a Ciel
	"""
	msgClear
	"""
	llamarte hace
	un momento.
	"""
	msgClear
	"""
	Así que eres el
	legendario Reploide,
	Zero.
	"""
	msgClear
	mugshotShow
		mugshot = 4
	"""
	No queremos que
	se difundan rumores
	extraños
	"""
	msgClear
	"""
	sobre nosotros.
	"""
	msgClear
	mugshotShow
		mugshot = 61
	"""
	No pasará.
	Solo te digo lo
	que he oído.
	"""
	msgClear
	"""
	Pero otros podrían
	pensar distinto
	que yo.
	"""
	end
}

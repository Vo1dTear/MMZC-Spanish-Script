script 0 mmz4 {
	mugshotShow
		mugshot = 4
	"""
	¿Averiguaste algo
	sobre Área Zero?
	"""
	msgClear
	mugshotShow
		mugshot = 7
	"""
	Sí...
	No está lejos de
	aquí.
	"""
	msgClear
	"""
	Neige y los demás
	deberían llegar
	pronto.
	"""
	msgClear
	"""
	Área Zero es el
	lugar de las Guerras
	Maverick, donde
	"""
	msgClear
	"""
	la colonia espacial
	Eurasia se
	estrelló...
	"""
	msgClear
	"""
	Muchas vidas se
	perdieron allí...
	"""
	msgClear
	mugshotShow
		mugshot = 4
	"""
	Área Zero es un
	recordatorio doloroso
	de una guerra
	"""
	msgClear
	"""
	pasada...
	"""
	msgClear
	"""
	¿Ahora viven
	humanos allí?
	"""
	end
}

script 16 mmz4 {
	mugshotShow
		mugshot = 27
	"""
	Gaaah...
	Me hiciste esperar,
	héroe.
	"""
	msgClear
	"""
	Pensé que mis
	ayudantes te habrían
	hecho pedazos.
	"""
	msgClear
	"""
	Y aquí me apresuré
	a preparar todo
	para ti.
	"""
	msgClear
	"""
	¡Aunque claro, nadie
	puede seguirme el
	ritmo!
	"""
	msgClear
	"""
	Al menos espero que
	logres hacer esto
	interesante.
	"""
	msgClear
	"""
	Después de todo,
	eres un héroe.
	"""
	end
}
script 17 mmz4 {
	mugshotShow
		mugshot = 27
	"""
	¡Gaaah!
	¿¡Qué!?
	¿¡Ya terminó!?
	"""
	msgClear
	"""
	¡Qué aburrido!
	Deberías dejar eso
	de ser héroe.
	"""
	end
}
script 18 mmz4 {

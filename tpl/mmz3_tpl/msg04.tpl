@archive msg04
@size 6

script 0 mmz3 {
	mugshotShow
		mugshot = 100
	"""
	Operadora:
	Se ha detectado
	una fuerte lectura
	"""
	msgClear
	"""
	de energía.
	"""
	msgClear
	"""
	Están construyendo
	un enorme misil
	fuera de la base.
	"""
	msgClear
	"""
	La base debe estar
	aquí para apoyar la
	construcción.
	"""
	msgClear
	"""
	Ciel:
	Analizar una ruta
	hasta la fábrica
	"""
	msgClear
	"""
	de misiles
	tomará bastante
	tiempo...
	"""
	msgClear
	"""
	Zero, ¿qué
	deberíamos hacer?
	"""
	msgClear
	mugshotShow
		mugshot = 4
	"""
	Muy bien. Ganaré
	algo de tiempo
	atacando la base.
	"""
	msgClear
	"""
	¡Empieza el
	análisis!
	"""
	end
}
script 2 mmz3 {
	mugshotShow
		mugshot = 23
	"""
	Casi había perdido
	la esperanza de
	encontrar a alguien
	"""
	msgClear
	"""
	digno de
	enfrentarme...
	"""
	msgClear
	"""
	Parece que al
	menos podrías ser
	un pequeño desafío.
	"""
	msgClear
	"""
	¡Voy a disfrutar
	esto, Zero!
	"""
	end
}
script 3 mmz3 {
	mugshotShow
		mugshot = 7
	"""
	¡Ssyaaaaah!
	"""
	msgClear
	"""
	¡Prepárate para
	Blazin' Flizard,
	"""
	msgClear
	"""
	uno de los Numbers
	de Weil!
	"""
	msgClear
	"""
	¡Vamos a subir la
	temperatura,
	Zerrroooo!!!
	"""
	end
}
script 4 mmz3 {
	mugshotShow
		mugshot = 6
	"""
	¿Qué?, ¿eso es todo
	lo que tienes?
	"""
	msgClear
	"""
	Qué... insípido.
	Y yo que esperaba
	divertirme un poco.
	"""
	msgClear
	"""
	¡Ssyahahah!
	"""
	end
}
script 5 mmz3 {
	mugshotShow
		mugshot = 6
	"""
	¿Quién eres tú
	para... apagar
	mis llamas?
	"""
	msgClear
	"""
	Lord Weil
	acabará contigo...
	No lo dudes...
	"""
	msgClear
	"""
	Cubrirá el mundo
	entero en llamas,
	ya lo verás.
	"""
	msgClear
	"""
	No puedes...
	apagar las llamas...
	"""
	msgClear
	"""
	de nuestro
	nuevo mundo...
	"""
	msgClear
	"""
	¡Ssyah...aaaarrgh!
	"""
	end
}

@archive msg0A
@size 3

script 0 mmz3 {
	mugshotShow
		mugshot = 41
	"""
	Mi cuerpo
	ha vuelto de
	la ruina...
	"""
	msgClear
	"""
	Por Lord Weil,
	quien me dio
	vida...
	"""
	msgClear
	"""
	¡He regresado!
	Y ahora tomaré tu
	miserable alma.
	"""
	msgClear
	"""
	¡Veamos si peleas
	"""
	msgClear
	"""
	como un héroe!
	"""
	end
}
script 1 mmz3 {
	mugshotShow
		mugshot = 40
	"""
	¡La justicia está
	del lado de los
	Neo Arcadianos!
	"""
	end
}
script 2 mmz3 {
	mugshotShow
		mugshot = 40
	"""
	¡Fue una lucha
	impresionante!
	Pero...
	"""
	msgClear
	"""
	¡El mal siempre
	fracasa al final!
	"""
	msgClear
	"""
	¡La historia
	juzgará quién fue el
	verdadero vencedor!
	"""
	msgClear
	"""
	¡Que perezcas,
	oh antiguo Dios
	de la Destrucción!
	"""
	end
}
